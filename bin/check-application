#!/usr/bin/env python3
"""Run Jeeves application checks; bin/check --full calls this after the foundation checks."""
from pathlib import Path
import subprocess
import sys

try:
    result = subprocess.run(['bundle', 'exec', 'rake', 'validate'],
                            cwd=Path(__file__).resolve().parents[1]).returncode
except OSError as error:
    print(error, file=sys.stderr)
    result = 1
sys.exit(result)
